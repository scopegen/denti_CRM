# Copy to .env for local development. Values match scripts/dev_db.ps1.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://denti_app:denti_app_dev@localhost:5434/denti_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://denti_owner:denti_owner_dev@localhost:5434/denti_dev
JWT_SECRET=change-me-local-only
CORS_ORIGINS=http://localhost:5180
# Where the app's pages are, for links sent to patients on WhatsApp.
APP_BASE_URL=http://localhost:5180
