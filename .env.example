# Copy to .env for local development. Values match scripts/dev_db.ps1.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://denti_app:denti_app_dev@localhost:5434/denti_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://denti_owner:denti_owner_dev@localhost:5434/denti_dev
JWT_SECRET=change-me-local-only
CORS_ORIGINS=http://localhost:5180
# Where the app's pages are, for links sent to patients on WhatsApp.
APP_BASE_URL=http://localhost:5180

# Email. "console" prints emails, with their sign in and sign up codes, in the backend window,
# which is right for local development only. A live server (ENVIRONMENT=production) refuses to
# start with it: set these instead, for a mailbox on your own domain made in your host's email
# settings (cPanel or similar), and turn on SPF and DKIM for the domain so codes reach inboxes.
# The password goes only in the server's .env, never in git.
EMAIL_BACKEND=console
# EMAIL_BACKEND=smtp
# EMAIL_FROM=Denti <no-reply@scopegen.in>
# SMTP_HOST=mail.scopegen.in
# SMTP_PORT=465
# SMTP_USER=no-reply@scopegen.in
# SMTP_PASSWORD=
